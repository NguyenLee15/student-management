# ==============================================================================
# EduPortal Production Environment Configuration Template (.env)
# COPY THIS FILE TO .env ON VPS AND FILL IN THE REAL SECRETS. NEVER COMMIT .env!
# ==============================================================================

# Database Credentials
DB_NAME=student_management_db
DB_USERNAME=eduportal_app
DB_PASSWORD=YourStrongDatabasePassword123!

# JWT Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=your-secure-random-256-bit-jwt-secret-key-here-minimum-32-chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# PayOS (VietQR Payment Gateway)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Initial Production Admin Bootstrap (Used only once to seed admin)
INITIAL_ADMIN_USERNAME=admin_prod
INITIAL_ADMIN_PASSWORD=InitialAdminPasswordMustChange123!

# Email Service (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Real-time Alerting Bot (Optional - Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

